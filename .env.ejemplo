# Copia este archivo como ".env" y completa tus datos. NUNCA subas el .env a GitHub.
# Ejemplo para Gmail: usa una "contraseña de aplicación", no tu clave normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=tu_correo@gmail.com
SMTP_CLAVE=tu_contraseña_de_aplicacion
SMTP_REMITENTE=tu_correo@gmail.com
